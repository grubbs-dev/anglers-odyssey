)

$modelPath = "src/main/resources/assets/$modid/models/item"
$langPath = "src/main/resources/assets/$modid/lang/en_us.json"

New-Item -ItemType Directory -Force -Path $modelPath | Out-Null
New-Item -ItemType Directory -Force -Path (Split-Path $langPath) | Out-Null

$lang = [ordered]@{}

foreach ($f in $fish) {
    $model = @{
        parent = "item/generated"
        textures = @{
            layer0 = "$modid`:item/$($f.id)"
        }
    }

    $model | ConvertTo-Json -Depth 5 | Set-Content "$modelPath/$($f.id).json" -Encoding UTF8

    $lang["item.$modid.$($f.id)"] = $f.name
}

$lang | ConvertTo-Json -Depth 5 | Set-Content $langPath -Encoding UTF8

Write-Host "Generated models and language entries for all fish."